{
  "//": "本项目的代码全部来自上游 MediaWiki-MCP-Server（见 src/mediawiki/ 下各文件的出处说明）加上 BWiki 适配层（src/mediawiki/bwiki/）。上游用 .ts 后缀的 import（Node 原生 TS 语法）且未按 noUncheckedIndexedAccess 编写，因此整个 src/ 沿用上游的构建口径。",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": "src/mediawiki",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/mediawiki/**/*.ts"]
}
